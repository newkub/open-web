{
  "name": "@open-web/icons-bun",
  "version": "0.1.0",
  "description": "Material Icon Theme resolver for open-web file trees",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mit-map.json": "./src/mit-map.json"
  },
  "files": ["dist", "src/mit-map.json"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newkub/open-web.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
